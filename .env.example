# Application
APP_NAME=QuickCart
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=REPLACE_WITH_RANDOM_STRING_MIN_32_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Database (Render will provide this automatically if you use a Blueprint)
POSTGRES_USER=quickcart
POSTGRES_PASSWORD=quickcart_dev_pw
POSTGRES_DB=quickcart
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://quickcart:quickcart_dev_pw@localhost:5432/quickcart
# Redis
REDIS_URL=redis://localhost:6379/0
# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Messaging
MSG91_AUTH_KEY=
RESEND_API_KEY=
# CORS (comma-separated, no spaces)
CORS_ORIGINS=http://localhost:8000,http://localhost:5555